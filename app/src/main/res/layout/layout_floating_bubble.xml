<?xml version="1.0" encoding="utf-8"?>
<com.veexdevs.lumyxpainel.DraggableOverlayLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:contentDescription="@string/btn_show_window"
    android:focusable="false"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_floating_bubble"
        android:clickable="false"
        android:elevation="10dp"
        android:focusable="false">

        <ImageView
            android:id="@+id/ivBubbleIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lumyx_logo" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_bubble_dot"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>
</com.veexdevs.lumyxpainel.DraggableOverlayLayout>
