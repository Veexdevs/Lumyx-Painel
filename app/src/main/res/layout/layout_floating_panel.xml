<?xml version="1.0" encoding="utf-8"?>
<com.veexdevs.lumyxpainel.DraggableOverlayLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/panelCard"
        android:layout_width="288dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_panel"
        android:elevation="12dp"
        android:orientation="vertical">

        <!-- Cabeçalho Arrastável Redx Painel -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_redx" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_red"
                        android:textColor="@color/redx_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/brand_white"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_drag_hint"
                    android:textColor="@color/redx_accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/panel_drag_hint"
                android:src="@drawable/ic_drag_indicator" />

            <!-- Botão Esconder no Cabeçalho -->
            <ImageButton
                android:id="@+id/btnHeaderHide"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_header_icon_btn"
                android:contentDescription="@string/panel_action_hide"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_minimize" />

            <!-- Botão Fechar no Cabeçalho -->
            <ImageButton
                android:id="@+id/btnHeaderClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_header_close_btn"
                android:contentDescription="@string/panel_action_close"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Corpo do Painel -->
        <LinearLayout
            android:id="@+id/panelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <!-- Status e Tempo Ativo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOverlayInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/panel_status_active"
                    android:textColor="@color/redx_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSessionTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Container de Opções (recolhe no Modo Compacto) -->
            <LinearLayout
                android:id="@+id/settingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAimAssist"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:checked="false"
                    android:text="@string/panel_aim_assist"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:thumbTint="@color/redx_primary"
                    app:trackTint="@color/stroke_subtle" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFpsBoost"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="4dp"
                    android:checked="false"
                    android:text="@string/panel_fps_boost"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:thumbTint="@color/redx_primary"
                    app:trackTint="@color/stroke_subtle" />

                <!-- Sensibilidade Redx -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/panel_sensi_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSensiValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="145"
                        android:textColor="@color/redx_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"
                    android:max="200"
                    android:progress="145"
                    android:progressBackgroundTint="@color/stroke_subtle"
                    android:progressTint="@color/redx_primary"
                    android:thumbTint="@color/redx_accent" />

                <!-- Opacidade da Janela -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/panel_opacity_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvOpacityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="95%"
                        android:textColor="@color/redx_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"
                    android:max="65"
                    android:progress="60"
                    android:progressBackgroundTint="@color/stroke_subtle"
                    android:progressTint="@color/redx_primary"
                    android:thumbTint="@color/redx_accent" />

                <!-- Tamanho da Bolinha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/panel_bubble_size_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvBubbleSizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="58dp"
                        android:textColor="@color/redx_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBubbleSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="4dp"
                    android:max="32"
                    android:progress="12"
                    android:progressBackgroundTint="@color/stroke_subtle"
                    android:progressTint="@color/redx_primary"
                    android:thumbTint="@color/redx_accent" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSnapEdge"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:checked="false"
                    android:text="@string/panel_snap_edge"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:thumbTint="@color/redx_primary"
                    app:trackTint="@color/stroke_subtle" />
            </LinearLayout>

            <!-- Modo Compacto (sempre visível) -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCompact"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:checked="false"
                android:text="@string/panel_compact_mode"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:thumbTint="@color/redx_primary"
                app:trackTint="@color/stroke_subtle" />

            <!-- Botões Esconder & Fechar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHideWindow"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/panel_action_hide"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/redx_primary"
                    app:cornerRadius="999dp"
                    app:icon="@drawable/ic_visibility_off"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClosePanel"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/panel_action_close"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#260609"
                    app:cornerRadius="999dp"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"
                    app:strokeColor="@color/redx_primary_dark"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.veexdevs.lumyxpainel.DraggableOverlayLayout>
