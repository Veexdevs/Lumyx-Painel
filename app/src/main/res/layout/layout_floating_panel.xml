<?xml version="1.0" encoding="utf-8"?>
<com.veexdevs.lumyxpainel.DraggableOverlayLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/panelCard"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <!-- Cabeçalho: Logo RX + Título/Subtítulo + [—] [✕] -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPanelLogo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_redx" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPanelHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="@string/panel_header_title"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPanelHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="@string/panel_header_version"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botão Esconder (—) -->
            <ImageButton
                android:id="@+id/btnHeaderHide"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_header_plain_ripple"
                android:contentDescription="@string/panel_action_hide"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_minimize" />

            <!-- Botão Fechar (✕) -->
            <ImageButton
                android:id="@+id/btnHeaderClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_header_plain_ripple"
                android:contentDescription="@string/panel_action_close"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Corpo Dinâmico em 2 Colunas gerado a partir do PainelConfig.kt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- Coluna Esquerda: Abas geradas pelo PainelConfig.kt -->
            <com.veexdevs.lumyxpainel.MaxHeightScrollView
                android:id="@+id/tabsScrollView"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.veexdevs.lumyxpainel.MaxHeightScrollView>

            <!-- Coluna Direita: Botões, Toggles, Checks, Slides e Listas gerados pelo PainelConfig.kt -->
            <com.veexdevs.lumyxpainel.MaxHeightScrollView
                android:id="@+id/itemsScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fadeScrollbars="true"
                android:overScrollMode="never"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/itemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.veexdevs.lumyxpainel.MaxHeightScrollView>
        </LinearLayout>
    </LinearLayout>
</com.veexdevs.lumyxpainel.DraggableOverlayLayout>
