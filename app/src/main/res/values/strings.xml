    <!-- Guia -->
    <string name="guide_card_title">Como Funciona</string>
    <string name="guide_step_1">1. Toque em Abrir Janela Flutuante para exibir o painel na tela.</string>
    <string name="guide_step_2">2. Arraste a janela livremente por qualquer área do painel.</string>
    <string name="guide_step_3">3. Toque em Esconder para recolher na bolinha flutuante (também arrastável).</string>
    <string name="guide_step_4">4. Toque na bolinha para a janela aparecer novamente, ou em Fechar para encerrar.</string>

